# .env.example
# ------------------------------------------------------------
# Application
NEXTAUTH_URL="https://your-app.onrender.com"
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"

# Database (PostgreSQL — provided automatically by Render)
DATABASE_URL="postgresql://user:password@host:5432/mediconnect?sslmode=require"

# MongoDB (for the signaling server — use MongoDB Atlas free tier)
MONGO_URI="mongodb+srv://user:password@cluster.mongodb.net/hms-mern"

# Resend Email (for email notifications)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="MediConnect <onboarding@resend.dev>"

# OpenAI (for other AI features)
OPENAI_API_KEY="your-openai-key"

# Twilio
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_API_KEY="your-twilio-api-key"
TWILIO_API_SECRET="your-twilio-api-secret"

# Razorpay
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# AWS S3
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="your-s3-bucket-name"

# Firebase
FIREBASE_SERVER_KEY="your-firebase-server-key"


# Public URL (used by Next.js)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
