# .env.example
# ------------------------------------------------------------
# Application
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hospital_telemed"

# Resend Email (for email notifications)
RESEND_API_KEY="your-resend-api-key"
EMAIL_FROM="MediConnect <onboarding@resend.dev>"

# OpenAI (for other AI features)
OPENAI_API_KEY="your-openai-key"

# Twilio
TWILIO_ACCOUNT_SID="your-twilio-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_API_KEY="your-twilio-api-key"
TWILIO_API_SECRET="your-twilio-api-secret"

# Razorpay
RAZORPAY_KEY_ID="your-razorpay-key-id"
RAZORPAY_KEY_SECRET="your-razorpay-key-secret"

# AWS S3
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_S3_BUCKET="your-s3-bucket-name"

# Firebase
FIREBASE_SERVER_KEY="your-firebase-server-key"


# Public URL (used by Next.js)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
